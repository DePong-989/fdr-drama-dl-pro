{
  "name": "fdr-drama-dl-pro",
  "version": "2.0.4",
  "description": "FDR Drama DL Pro - Luxury VIP Short Drama Downloader with Multi-CDN Aggregation",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npx electron-builder --win",
    "build:installer": "npx electron-builder --win nsis",
    "build:portable": "npx electron-builder --win portable",
    "build:dir": "npx electron-builder --win dir",
    "organize": "node organize_build.js",
    "release": "npx electron-builder --win && node organize_build.js",
    "publish:github": "npx electron-builder --win && node publish_release.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "drama",
    "downloader",
    "hongguo",
    "electron"
  ],
  "author": "FDR Studio",
  "license": "ISC",
  "devDependencies": {
    "electron": "^34.5.8"
  },
  "dependencies": {
    "bakong-khqr": "^1.0.20",
    "electron-updater": "^6.8.11",
    "hls.js": "^1.7.3",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.fdr.dramadlpro",
    "productName": "FDR Download Drama Pro",
    "directories": {
      "output": "dist_release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DePong-989",
        "repo": "fdr-drama-dl-pro"
      }
    ],
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "FDR Download Drama.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "data/**",
      "node_modules/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ]
  }
}